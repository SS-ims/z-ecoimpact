<!doctype html>
<html lang="pt-PT">
<%- include('partials/head', { title: 'Serviços — Z Ecoimpact' }) %>

  <body>
    <div class="eco-site">
      <%- include('partials/nav', { activePage: 'services' }) %>

        <main class="main eco-main">
          <div class="topbar eco-topbar">
            <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menu">☰</button>
            <div class="brand">Z Ecoimpact Consulting LDA</div>
            <div class="top-call">+258 8777 68890</div>
          </div>

          <section class="eco-hero">
            <!-- Use the shared hero artwork consistently across every EJS page. -->
            <div class="hero-banner">
              <img src="/images/hero.png" alt="Z Ecoimpact Consulting LDA" class="hero-image">
            </div>
          </section>

          <section class="services-panel">
            <div class="panel-title">Nossos Serviços</div>
            <div class="service-grid">
              <div class="service-card">
                <div class="service-icon">♻</div>
                <h3>Consultoria Ambiental</h3>
                <p>Estudos de Impacto Ambiental (EIA), auditorias ambientais, licenciamento e planos de gestão
                  ambiental.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">🌿</div>
                <h3>Biodiversidade</h3>
                <p>Estudos de fauna e flora, planos de conservação e gestão de áreas protegidas.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">💧</div>
                <h3>Recursos Hídricos</h3>
                <p>Gestão da água, monitoria ambiental e soluções para uso sustentável dos recursos hídricos.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">📊</div>
                <h3>Sustentabilidade e Clima</h3>
                <p>Estratégias de sustentabilidade, adaptação e mitigação das mudanças climáticas.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">🛡</div>
                <h3>Segurança e Saúde</h3>
                <p>Consultoria em HSE, avaliação de riscos e implementação de sistemas de gestão.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">🎓</div>
                <h3>Capacitação e Formação</h3>
                <p>Treinamentos e workshops em meio ambiente, segurança e sustentabilidade.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">♻</div>
                <h3>Gestão de Resíduos</h3>
                <p>Planos de gestão de resíduos, reciclagem e soluções para resíduos sólidos e industriais.</p>
              </div>
              <div class="service-card">
                <div class="service-icon">📌</div>
                <h3>Monitoria e Fiscalização</h3>
                <p>Monitoria ambiental, relatórios técnicos e acompanhamento de projectos.</p>
              </div>
            </div>
          </section>

          <section class="eco-why-us">
            <div class="why-us-inner">
              <h3>Como trabalhamos</h3>
              <ul>
                <li>Diagnóstico técnico e ambiental</li>
                <li>Planeamento e desenho de soluções</li>
                <li>Implementação com acompanhamento contínuo</li>
                <li>Apoio à conformidade e melhoria de desempenho</li>
              </ul>
            </div>
            <div class="mission-box">
              <p>Impacto<br>com responsabilidade</p>
            </div>
          </section>

          <%- include('partials/footer') %>
        </main>
    </div>

    <script src="/scripts/main.js"></script>
  </body>

</html>