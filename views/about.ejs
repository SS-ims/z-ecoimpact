<!doctype html>
<html lang="pt-PT">
<%- include('partials/head', { title: 'Sobre Nós — Z Ecoimpact' }) %>

    <body>
        <div class="eco-site">
            <%- include('partials/nav', { activePage: 'about' }) %>

                <main class="main eco-main">
                    <div class="topbar eco-topbar">
                        <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menu">☰</button>
                        <div class="brand">Z Ecoimpact Consulting LDA</div>
                        <div class="top-call">+258 8777 68890</div>
                    </div>

                    <section class="eco-hero">
                        <!-- Use the shared hero artwork consistently across every EJS page. -->
                        <div class="hero-banner">
                            <img src="/images/hero.png" alt="Z Ecoimpact Consulting LDA" class="hero-image">
                        </div>
                    </section>

                    <section class="eco-intro">
                        <div class="eco-intro-copy">
                            <h2>Quem somos</h2>
                            <p>
                                A Z ECOIMPACT é uma empresa de consultoria focada em soluções ambientais, energéticas e
                                de sustentabilidade,
                                com o objetivo de apoiar governos, empresas e comunidades na construção de um
                                desenvolvimento mais responsável,
                                eficiente e alinhado com as metas globais de proteção ambiental.
                            </p>
                        </div>

                        <div class="eco-commitment">
                            <p>Impacto positivo, desenvolvimento sustentável</p>
                        </div>
                    </section>

                    <section class="services-panel">
                        <div class="panel-title">A nossa missão</div>
                        <div class="service-grid service-grid--three">
                            <div class="service-card mission-card">
                                <h2>MISSÃO</h2>
                                <p>
                                    Prestar serviços técnicos e profissionais de elevada qualidade nas áreas ambiental,
                                    energética e de sustentabilidade, contribuindo para o desenvolvimento económico e
                                    social sustentável, a conservação dos recursos naturais e a melhoria da qualidade de
                                    vida das comunidades.
                                </p>
                            </div>

                            <div class="service-card">
                                <div class="service-icon">🌍</div>
                                <h3>Proteção Ambiental</h3>
                                <p>Promovemos práticas que reduzem impactos negativos no ambiente e fortalecem a
                                    resiliência dos territórios.</p>
                            </div>

                            <div class="service-card">
                                <div class="service-icon">⚡</div>
                                <h3>Energia e eficiência</h3>
                                <p>Desenvolvemos soluções energéticas sustentáveis e eficientes para apoiar a
                                    produtividade e a economia local.</p>
                            </div>

                            <div class="service-card">
                                <div class="service-icon">🤝</div>
                                <h3>Parceria e confiança</h3>
                                <p>Trabalhamos com rigor técnico, ética e compromisso para entregar resultados com
                                    impacto real para cada cliente.</p>
                            </div>
                            <div class="vision-card">
                            <h2>VISÃO</h2>
                                <p>Ser uma empresa de referência em Moçambique na prestação de serviços de consultoria ambiental, sustentabilidade, energia e gestão de recursos naturais, reconhecida pela qualidade, inovação e responsabilidade profissional.</p>
                            </div>
                        </div>
                    </section>

                    <section class="eco-why-us">
                        <div class="why-us-inner">
                            <h3>Valores</h3>
                            <ul>
                              <li>Profissionalismo</li>
                              <li>Integridade</li>
                              <li>Inovação</li>
                              <li>Sustentabilidade</li>
                              <li>Responsabilidade</li>
                              <li>Qualidade</li>
                              <li>Compromisso com o cliente</li>
                              <li>Protecção do ambiente</li>
                            </ul>
                        </div>

                        <div class="mission-box">
                            <p>Ambiente,<br>nossa missão,<br>seu futuro!</p>
                        </div>
                    </section>

                    <%- include('partials/footer') %>
                </main>
        </div>

        <script src="/scripts/main.js"></script>
    </body>

</html>