<!doctype html>
<html lang="en">
<%- include('partials/head', { title: 'Product — Z Ecoimpact' }) %>
<body>
<div class="app">
  <%- include('partials/nav', { activePage: 'products' }) %>

  <main class="main">
    <div class="topbar"><button type="button" id="menu-toggle" class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">☰</button><div class="brand">Product</div></div>

    <section class="section">
      <% if (!product) { %>
        <h2>Product not found</h2>
        <p class="muted">Please return to the product list.</p>
        <a class="btn btn-primary" href="/products">Back to products</a>
      <% } else { %>
        <div class="product-layout">
          <div class="product-column"><img src="/<%= product.image %>" class="product-image" alt="<%= product.name %>"></div>
          <div class="product-column">
            <h1><%= product.name %></h1>
            <p><%= product.description %></p>
            <div class="product-price"><%= formatCurrency(product.price) %></div>
            <div class="product-actions">
              <button class="detail-add-to-cart" data-id="<%= product.id %>">Add to cart</button>
            </div>
          </div>
        </div>
      <% } %>
    </section>

    <%- include('partials/footer') %>
  </main>
</div>

<script src="/scripts/main.js"></script>
</body>
</html>
