<!doctype html>
<html lang="pt-PT">
<%- include('partials/head', { title: 'Contactos — Z Ecoimpact' }) %>

  <body>
    <div class="eco-site">
      <%- include('partials/nav', { activePage: 'contact' }) %>

        <main class="main eco-main">
          <div class="topbar eco-topbar">
            <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menu">☰</button>
            <div class="brand">Z Ecoimpact Consulting LDA</div>
            <div class="top-call">+258 8777 68890</div>
          </div>

          <section class="eco-hero hero-centered">
            <div class="eco-brand-copy eco-brand-stack">
              <img src="/images/brand.jpeg" alt="Z Ecoimpact" class="hero-brand-image">
              <img src="/images/consulting.jpeg" alt="Consulting" class="hero-brand-image hero-brand-image--small">
            </div>
          </section>

          <section class="eco-intro">
            <div class="eco-intro-copy">
              <h2>Fale connosco</h2>
              <p>Se pretende discutir uma solução sustentável, uma consultoria ambiental ou um projecto de eficiência
                energética, entre em contacto com a nossa equipa.</p>
            </div>
            <div class="eco-commitment">
              <p>Consultoria com propósito,<br>resultados com impacto</p>
            </div>
          </section>

          <section class="services-panel">
            <div class="panel-title">Enviar mensagem</div>
            <div class="service-grid contact-form-shell">
              <div class="service-card contact-card">
                <form id="contact-form" class="contact-form">
                  <input name="name" required placeholder="Nome completo" class="contact-field">
                  <input name="email" required placeholder="Email" class="contact-field">
                  <textarea name="message" required placeholder="Mensagem" class="contact-textarea"></textarea>
                  <div><button class="btn btn-primary contact-submit" type="submit">Enviar</button></div>
                </form>
                <div id="contact-result" class="contact-result"></div>
              </div>
            </div>
          </section>

          <section class="contact-strip">
            <div class="contact-callout">
              <h3>Informações</h3>
              <p>Estamos prontos para transformar ideias em soluções concretas.</p>
            </div>
            <div class="contact-lines">
              <p>+258 8777 68890</p>
              <p>+258 8477 68894</p>
              <p>zecoimpactconsulting@gmail.com</p>
              <p>www.zecoimpact.co.mz</p>
              <p>Telefone – Moçambique</p>
            </div>
            <div class="qr-box">
              <span>Sigam-nos</span>
              <div class="qr-placeholder">QR</div>
            </div>
          </section>

          <%- include('partials/footer') %>
        </main>
    </div>

    <script src="/scripts/main.js"></script>
  </body>

</html>