# Copy these values into the cPanel Node.js application's Environment Variables.
NODE_ENV=production
PORT=3000

# cPanel MySQL database. cPanel commonly prefixes these names with the account username.
USE_MYSQL=true
DB_HOST=localhost
DB_USER=cpaneluser_zecoimpact
DB_PASSWORD=replace-with-database-password
DB_DATABASE=cpaneluser_zecoimpact

# Use the mailbox created in cPanel > Email Accounts.
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=contact@example.com
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_FROM=contact@example.com
CONTACT_RECIPIENT=contact@example.com

# Use long random values; do not commit these to the repository.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
