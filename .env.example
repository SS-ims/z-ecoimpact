# Copy these values into the cPanel Node.js application's Environment Variables.
NODE_ENV=production
PORT=3000

# cPanel MySQL database. cPanel commonly prefixes these names with the account username.
USE_MYSQL=true
DB_HOST=localhost
DB_USER=cpaneluser_zecoimpact
DB_PASSWORD=replace-with-database-password
DB_DATABASE=cpaneluser_zecoimpact

# Use the mailbox created in cPanel > Email Accounts. The server accepts
# these SMTP_* names directly and keeps the password outside the repository.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@example.com
SMTP_PASS=replace-with-mailbox-password
SMTP_FROM=contact@example.com
CONTACT_RECIPIENT=zaqueuaugusto94@gmail.com

# Use long random values; do not commit these to the repository.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
